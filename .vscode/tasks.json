{
  "version": "2.0.0",
  "tasks": [
    {
      // Trae los últimos cambios remotos al abrir la carpeta, para no ramificar de un main viejo.
      // La primera vez VSCode pide permiso: "Manage Automatic Tasks" → "Allow Automatic Tasks".
      "label": "git fetch (al abrir el proyecto)",
      "type": "shell",
      "command": "git fetch --all --prune",
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "silent", "panel": "shared", "close": true },
      "problemMatcher": []
    }
  ]
}
